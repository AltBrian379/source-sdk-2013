{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "PowerShell(powershell -ExecutionPolicy Bypass -File tools/build.ps1*)",
      "PowerShell(powershell -ExecutionPolicy Bypass -File tools\\build.ps1*)",
      "Bash(powershell -ExecutionPolicy Bypass -File tools/build.ps1*)"
    ],
    "deny": [
      "Edit(/src/thirdparty/**)",
      "Edit(/src/devtools/**)",
      "Edit(**/*.sln)",
      "Edit(**/*.vcxproj)",
      "Edit(**/*.vcxproj.filters)"
    ]
  }
}
